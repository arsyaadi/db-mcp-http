# Copy to .env and fill in.
HOST=127.0.0.1
PORT=3333
# Shared secret clients send as "Authorization: Bearer <token>". Generate: openssl rand -hex 32
MCP_TOKEN=

# Optional SSH tunnel. Leave SSH_HOST empty to connect to DB_HOST directly. Key path may start with ~/
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=~/.ssh/id_ed25519
SSH_PASSPHRASE=

# Required. Database environment told to Claude on every connection: dev or production.
DB_ENV=dev

# MySQL as seen from the SSH server (or from this machine without SSH).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Server name shown to clients (default db-mcp).
MCP_NAME=db-mcp
# Guide pack folder (instructions.md, reminder.md, NN-*.md), relative to the working dir.
GUIDE_DIR=guide
# Required, may be empty. App tables whose rows are secrets, e.g. password_resets,personal_access_tokens,sessions.
# MySQL system schemas are always blocked.
BLOCKED_TABLES=
